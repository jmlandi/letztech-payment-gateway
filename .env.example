# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway

# Redis
REDIS_URL=redis://localhost:6379

# Crypto — master key for encrypting per-store Koin credentials (AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_32_byte_hex_key_here_00

# Zoop (marketplace credentials)
ZOOP_MARKETPLACE_ID=your_marketplace_id
ZOOP_API_KEY=your_zoop_api_key
# Issued by Zoop alongside the mTLS certificate (separate from ZOOP_API_KEY) — see https://docs.zoop.co/docs/preparando-o-uso-do-mtls
ZOOP_X_API_KEY=your_zoop_x_api_key
ZOOP_SANDBOX=true
# mTLS client certificate (paths to files provided by Zoop)
ZOOP_CERT_PATH=/path/to/client.pem
ZOOP_KEY_PATH=/path/to/client.key
# ZOOP_WEBHOOK_SECRET=your_webhook_secret

# Koin (default/platform credentials — overridden per store in store_settings)
KOIN_SANDBOX=true

# Base URL of this service — required only when a store has Koin fraud enabled
# (used to build the Koin callbackUrl for under_review evaluations)
# BASE_URL=https://pay.letztech.com.br

# Wake Commerce
# IPs de saída da Wake para allowlist (opcional)
# WAKE_ALLOWED_IPS=

# Sentry (opcional)
# SENTRY_DSN=https://...

# Internal API
# API key usada pelo painel LetzTech para chamadas admin
ADMIN_API_KEY=change_me_admin_key
